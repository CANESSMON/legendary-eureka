[Unit]
Description=Job Portal FastAPI Backend
After=network.target postgresql.service redis-server.service

[Service]
User=root
Group=www-data
WorkingDirectory=/var/www/job-portal/backend
Environment="PATH=/var/www/job-portal/backend/venv/bin"
ExecStart=/var/www/job-portal/backend/venv/bin/gunicorn main:app -w 4 -k uvicorn.workers.UvicornWorker -b 127.0.0.1:8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
